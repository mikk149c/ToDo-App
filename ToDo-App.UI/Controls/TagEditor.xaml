<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="ToDo_App.UI.Controls.TagEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ToDo_App.UI.Controls">

    <StackPanel Spacing="8">
        <AutoSuggestBox
            x:Name="TagInput"
            Header="Tags"
            PlaceholderText="Add a tag and press Enter"
            QueryIcon="Add"
            GotFocus="OnTagInputGotFocus"
            QuerySubmitted="OnTagSubmitted"
            TextChanged="OnTagInputTextChanged" />

        <TextBlock
            x:Name="ErrorText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- One removable chip per tag -->
        <controls:WrapPanel
            x:Name="TagChips"
            AutomationProperties.Name="Tags on this todo"
            HorizontalSpacing="4"
            VerticalSpacing="4" />
    </StackPanel>
</UserControl>
