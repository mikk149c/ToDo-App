<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="ToDo_App.UI.Controls.TagEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ToDo_App.UI.Controls">

    <StackPanel Spacing="8">
        <FlyoutBase.AttachedFlyout>
            <!-- Opened from a tag's name. A flyout, because only one ContentDialog can be open at a time -->
            <Flyout x:Name="TagFlyout" Placement="Bottom">
                <StackPanel
                    x:Name="FlyoutRoot"
                    Width="240"
                    Spacing="8">
                    <TextBox
                        x:Name="FlyoutNameBox"
                        Header="Name"
                        KeyDown="OnFlyoutNameKeyDown"
                        MaxLength="12" />

                    <TextBlock
                        x:Name="FlyoutInfoText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <!-- Only for tags on the board. Picking a colour applies to every todo with the tag -->
                    <StackPanel x:Name="ColorPanel" Spacing="4">
                        <TextBlock x:Name="ColorHeader" />
                        <GridView
                            x:Name="ColorGrid"
                            AutomationProperties.Name="Colour"
                            IsItemClickEnabled="False"
                            SelectionChanged="OnColorSelectionChanged"
                            SelectionMode="Single">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>

                    <TextBlock
                        x:Name="FlyoutErrorText"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <StackPanel
                        x:Name="FlyoutActions"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="RenameButton"
                            Click="OnRenameClicked"
                            Content="Rename"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="DeleteButton"
                            Click="OnDeleteClicked"
                            Content="Delete" />
                    </StackPanel>

                    <!-- Delete asks before removing the tag from every todo -->
                    <StackPanel
                        x:Name="DeleteConfirmPanel"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock x:Name="DeleteConfirmText" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ConfirmDeleteButton"
                                Click="OnConfirmDeleteClicked"
                                Content="Delete"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="CancelDeleteButton"
                                Click="OnCancelDeleteClicked"
                                Content="Cancel" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Renaming to another tag's name asks whether to merge the two tags (#68) -->
                    <StackPanel
                        x:Name="MergeConfirmPanel"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock x:Name="MergeConfirmText" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ConfirmMergeButton"
                                Click="OnConfirmMergeClicked"
                                Content="Merge"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="CancelMergeButton"
                                Click="OnCancelMergeClicked"
                                Content="Cancel" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </FlyoutBase.AttachedFlyout>

        <AutoSuggestBox
            x:Name="TagInput"
            Header="Tags"
            PlaceholderText="Add a tag and press Enter"
            QueryIcon="Add"
            GotFocus="OnTagInputGotFocus"
            QuerySubmitted="OnTagSubmitted"
            TextChanged="OnTagInputTextChanged" />

        <TextBlock
            x:Name="ErrorText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- One TagChip per tag -->
        <controls:WrapPanel
            x:Name="TagChips"
            AutomationProperties.Name="Tags on this todo"
            HorizontalSpacing="4"
            VerticalSpacing="4" />
    </StackPanel>
</UserControl>
