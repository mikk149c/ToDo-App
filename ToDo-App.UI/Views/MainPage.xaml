<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ToDo_App.UI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:ToDo_App.UI.Controls"
    xmlns:local="using:ToDo_App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <!-- Columns sit lighter than the page behind them in both themes so they stand out -->
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#D9DCE3" />
                <SolidColorBrush x:Key="BoardColumnBackgroundBrush" Color="#F4F5F7" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#161616" />
                <SolidColorBrush x:Key="BoardColumnBackgroundBrush" Color="#262626" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <x:Double x:Key="BoardColumnMinWidth">300</x:Double>
        <Style x:Key="BoardColumn" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource BoardColumnBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="BoardColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource MyLabel}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TodoCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="TodoTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}"/>
        </Style>

        <Style x:Key="TodoDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}"/>
        </Style>

        <!-- A tag shown on a card. The background is the tag's colour, set in code. Every palette colour
             keeps white text readable (WCAG AA) in both themes -->
        <Style x:Key="TodoTag" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="TodoTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
        </Style>
      </ResourceDictionary>
    </Page.Resources>

    <Page.Content>
        <Grid
            Padding="24"
            Background="{ThemeResource BoardBackgroundBrush}"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar above the columns -->
            <StackPanel Grid.Row="0" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AddColumnButton"
                        Click="OnClickAddColumn"
                        Style="{StaticResource PrimaryAction}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Add"/>
                                <TextBlock x:Name="AddColumnButtonTextBlock"></TextBlock>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button
                        x:Name="ImportButton"
                        Click="onImportBoardClicked"
                        Style="{StaticResource PrimaryAction}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenLocal"/>
                                <TextBlock x:Name="ImportButtonTextBlock"></TextBlock>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button
                        x:Name="ExportButton"
                        Click="onExportBoardClicked"
                        Style="{StaticResource PrimaryAction}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="SaveLocal"/>
                                <TextBlock x:Name="ExportButtonTextBlock"></TextBlock>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button
                        x:Name="TrashBinButton"
                        Click="OnTrashBinClicked"
                        Style="{StaticResource PrimaryAction}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete"/>
                                <TextBlock x:Name="TrashBinButtonTextBlock"></TextBlock>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <!-- Choose the tags to filter the board by. The list is built when it opens -->
                    <DropDownButton
                        x:Name="FilterButton"
                        Height="32"
                        VerticalAlignment="Center"
                        Content="Filter">
                        <DropDownButton.Flyout>
                            <Flyout x:Name="FilterFlyout" Opening="onFilterFlyoutOpening" Placement="BottomEdgeAlignedRight">
                                <StackPanel
                                    x:Name="FilterFlyoutContent"
                                    Width="260"
                                    Spacing="8" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <controls:AppearanceSelector x:Name="AppearanceSelector" VerticalAlignment="Center" />
                    <controls:FontSelector x:Name="FontSelector" VerticalAlignment="Center"></controls:FontSelector>
                    <controls:LanguageSelector x:Name="LanguageSelector" VerticalAlignment="Center"></controls:LanguageSelector>
                </StackPanel>
            </Grid>

            <!-- Shown while the board is filtered, so it's clear which tags are in use (#67) -->
            <StackPanel
                x:Name="FilterBar"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock x:Name="FilterBarLabel" VerticalAlignment="Center" />
                <StackPanel
                    x:Name="FilterBarTags"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4" />
                <TextBlock
                    x:Name="FilterBarMode"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ClearFilterButton" Click="onClearFilterClicked" />
            </StackPanel>
            </StackPanel>

            <!-- Board columns (stub data) -->
            <ScrollViewer
                x:Name="BoardScrollViewer"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">

                <Grid
                    x:Name="ColumnsPanel"
                    Width="{Binding ViewportWidth, ElementName=BoardScrollViewer}"
                    ColumnSpacing="16" 
                    Background="Transparent"
                    AllowDrop="True">
                    <Grid.ColumnDefinitions>
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Page.Content>
</Page>
