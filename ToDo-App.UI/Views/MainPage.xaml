<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ToDo_App.UI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ToDo_App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <x:Double x:Key="BoardColumnMinWidth">300</x:Double>
        <Style x:Key="BoardColumn" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="BoardColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource MyLabel}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TodoCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="TodoTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TodoDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Page.Content>
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar above the columns -->          
            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="12">

                <Button
                    Click="OnClickAddColumn"
                    Content="Add Column"
                    Style="{StaticResource Button_AddColumn}" />

                <Button
                    Click="OnAddTodoClicked"
                    Content="Add new ToDo"
                    Style="{StaticResource PrimaryAction}" />

                <Button
                    x:Name="ImportButton"
                    Click="onImportBoardClicked"
                    Style="{StaticResource PrimaryAction}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="OpenLocal"/>
                            <TextBlock Text="Import"></TextBlock>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button
                    x:Name="ExportButton"
                    Click="onExportBoardClicked"
                    Style="{StaticResource PrimaryAction}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="SaveLocal"/>
                            <TextBlock Text="Export"></TextBlock>
                        </StackPanel>
                    </Button.Content>
                </Button>

            </StackPanel>

            <!-- Board columns (stub data) -->
            <ScrollViewer
                x:Name="BoardScrollViewer"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">

                <Grid
                    x:Name="ColumnsPanel"
                    Width="{Binding ViewportWidth, ElementName=BoardScrollViewer}"
                    ColumnSpacing="16"> 
                    <Grid.ColumnDefinitions>
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Page.Content>
</Page>
