<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ToDo_App.UI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ToDo_App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="BoardColumn" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="BoardColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource MyLabel}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TodoCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="TodoTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TodoDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Page.Content>
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar above the columns -->
            <Button
                Grid.Row="0"
                Click="OnAddTodoClicked"
                Content="Add new ToDo"
                Style="{StaticResource PrimaryAction}" />

            <!-- Board columns (stub data) -->
            <Grid x:Name="ColumnsPanel" Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Planned -->
                <Border Grid.Column="0" Style="{StaticResource BoardColumn}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource BoardColumnHeader}" Text="Planned" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PlannedItems" Spacing="8">
                                <Border Style="{StaticResource TodoCard}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource TodoTitle}" Text="Design data model" />
                                        <TextBlock Style="{StaticResource TodoDescription}" Text="Decide which fields a ToDo needs." />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TodoCard}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource TodoTitle}" Text="Add persistence" />
                                        <TextBlock Style="{StaticResource TodoDescription}" Text="Store ToDos between app launches." />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TodoCard}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource TodoTitle}" Text="Drag and drop" />
                                        <TextBlock Style="{StaticResource TodoDescription}" Text="Move cards between columns." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- In progress -->
                <Border Grid.Column="1" Style="{StaticResource BoardColumn}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource BoardColumnHeader}" Text="In progress" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <Border Style="{StaticResource TodoCard}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource TodoTitle}" Text="Kanban board layout" />
                                        <TextBlock Style="{StaticResource TodoDescription}" Text="Three columns with an add button." />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TodoCard}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource TodoTitle}" Text="Style the cards" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Done -->
                <Border Grid.Column="2" Style="{StaticResource BoardColumn}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource BoardColumnHeader}" Text="Done" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <Border Style="{StaticResource TodoCard}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource TodoTitle}" Text="WinUI 3 setup" />
                                        <TextBlock Style="{StaticResource TodoDescription}" Text="Create the ToDo-App.UI project." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Page.Content>
</Page>
