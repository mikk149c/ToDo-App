<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ToDo_App.UI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:ToDo_App.UI.Controls"
    xmlns:local="using:ToDo_App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <!-- Columns sit lighter than the page behind them in both themes so they stand out -->
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#D9DCE3" />
                <SolidColorBrush x:Key="BoardColumnBackgroundBrush" Color="#F4F5F7" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#161616" />
                <SolidColorBrush x:Key="BoardColumnBackgroundBrush" Color="#262626" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <x:Double x:Key="BoardColumnMinWidth">300</x:Double>
        <Style x:Key="BoardColumn" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource BoardColumnBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="BoardColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource MyLabel}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TodoCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="TodoTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TodoDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
      </ResourceDictionary>
    </Page.Resources>

    <Page.Content>
        <Grid
            Padding="24"
            Background="{ThemeResource BoardBackgroundBrush}"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar above the columns -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AddColumnButton"
                        Click="OnClickAddColumn"
                        Content="Add Column"
                        Style="{StaticResource Button_AddColumn}" />

                    <Button
                        x:Name="AddToDoButton"
                        Click="OnAddTodoClicked"
                        Content="Add new ToDo"
                        Style="{StaticResource PrimaryAction}" />

                    <Button
                        x:Name="ImportButton"
                        Click="onImportBoardClicked"
                        Style="{StaticResource PrimaryAction}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenLocal"/>
                                <TextBlock x:Name="ImportButtonTextBlock"></TextBlock>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button
                        x:Name="ExportButton"
                        Click="onExportBoardClicked"
                        Style="{StaticResource PrimaryAction}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="SaveLocal"/>
                                <TextBlock x:Name="ExportButtonTextBlock"></TextBlock>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>

                <controls:AppearanceSelector Grid.Column="1" VerticalAlignment="Center" />
            </Grid>

            <!-- Board columns (stub data) -->
            <ScrollViewer
                x:Name="BoardScrollViewer"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">

                <Grid
                    x:Name="ColumnsPanel"
                    Width="{Binding ViewportWidth, ElementName=BoardScrollViewer}"
                    ColumnSpacing="16"> 
                    <Grid.ColumnDefinitions>
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Page.Content>
</Page>
