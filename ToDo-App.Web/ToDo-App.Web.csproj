<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ToDo_App.Web</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToDo-App\ToDo-App.csproj" />
  </ItemGroup>

  <!--
      Shared with the Windows app, so there's one default board and one set of translations.
      The .resx files are linked, not copied: a string is added or translated once, in ToDo-App.UI/Properties.
  -->
  <ItemGroup>
    <Content Include="..\ToDo-App.UI\Assets\default_board.json" Link="Assets\default_board.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\ToDo-App.UI\Properties\Resources*.resx" Link="Properties\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
