@implements IAsyncDisposable
@inject IJSRuntime JS

@* The web version of WinUI's ContentDialog: a modal with a title, content, a primary button and a close
   button. It's a native <dialog>, so focus stays inside it and the page behind can't be used. *@
<dialog @ref="element" class="content-dialog" aria-labelledby="@titleId" @onkeydown="OnKeyDown">
    <h2 id="@titleId" class="dialog-title">@Title</h2>
    <div class="dialog-content">
        @ChildContent
    </div>
    <div class="dialog-buttons">
        @FooterContent
    </div>
</dialog>

@code {
    private readonly string titleId = $"dialog-title-{Guid.NewGuid():N}";
    private ElementReference element;

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? PrimaryButtonText { get; set; }

    [Parameter, EditorRequired] public string CloseButtonText { get; set; } = "";

    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Called when the primary button is clicked. Returning false keeps the dialog open, like setting
    /// <c>args.Cancel</c> in WinUI's PrimaryButtonClick.
    /// </summary>
    [Parameter] public Func<bool>? PrimaryButtonClick { get; set; }

    /// <summary>Called after the primary button closed the dialog.</summary>
    [Parameter] public EventCallback Primary { get; set; }

    /// <summary>Called when the close button or Escape closed the dialog.</summary>
    [Parameter] public EventCallback Closed { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("todoApp.dialog.show", element);
        }
    }

    private async Task OnPrimary()
    {
        if (PrimaryButtonClick?.Invoke() == false)
        {
            return;
        }
        await Primary.InvokeAsync();
    }

    private Task OnClose()
    {
        return Closed.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // A flyout or suggestion list inside the dialog stops its own Escape from reaching here
        if (e.Key == "Escape")
        {
            await OnClose();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("todoApp.dialog.close", element);
        }
        catch (JSDisconnectedException)
        {
            // The tab is gone, and the dialog with it
        }
    }
}
