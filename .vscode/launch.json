{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ToDo-App.UI (x64)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/ToDo-App.UI/bin/x64/Debug/net10.0-windows10.0.19041.0/win-x64/ToDo-App.UI.exe",
            "cwd": "${workspaceFolder}/ToDo-App.UI",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "ToDo-App.UI (x64, unpackaged)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-unpackaged",
            "program": "${workspaceFolder}/ToDo-App.UI/bin/x64/Debug/net10.0-windows10.0.19041.0/win-x64/ToDo-App.UI.exe",
            "cwd": "${workspaceFolder}/ToDo-App.UI/bin/x64/Debug/net10.0-windows10.0.19041.0/win-x64",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "ToDo-App.Web",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-web",
            "program": "${workspaceFolder}/ToDo-App.Web/bin/Debug/net10.0/ToDo-App.Web.dll",
            "cwd": "${workspaceFolder}/ToDo-App.Web",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5133"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Attach to ToDo-App.UI",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
