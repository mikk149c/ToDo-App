{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/ToDo-App.UI/ToDo-App.UI.csproj",
                "-p:Platform=x64",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/ToDo-App.UI/ToDo-App.UI.csproj",
                "-p:Platform=x64"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "clean",
            "type": "process",
            "command": "dotnet",
            "args": [
                "clean",
                "${workspaceFolder}/ToDo-App.UI/ToDo-App.UI.csproj",
                "-p:Platform=x64"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-web",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/ToDo-App.Web/ToDo-App.Web.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run-web",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "${workspaceFolder}/ToDo-App.Web/ToDo-App.Web.csproj"
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile"
        },
        {
            "label": "server: docker compose up",
            "detail": "Builds and starts the web app and board server on http://localhost:8080",
            "type": "process",
            "command": "docker",
            "args": ["compose", "up", "--build", "--detach"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "server: docker compose down",
            "detail": "Stops the server. The board is kept in the todo-data volume",
            "type": "process",
            "command": "docker",
            "args": ["compose", "down"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "build-unpackaged",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/ToDo-App.UI/ToDo-App.UI.csproj",
                "-p:Platform=x64",
                "-p:WindowsPackageType=None",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
